DATABASE_URL=postgresql://tmc:tmc@localhost:5432/tmc_attendance
PORT=3000
# Behind a reverse proxy set the hop count (e.g. 1), otherwise all clients share one rate-limit bucket.
# Never 'true' without a proxy: a spoofed X-Forwarded-For would bypass the limit. Unset = no proxy.
# TRUST_PROXY=1
# Login/MFA attempts per IP per minute.
AUTH_RATE_LIMIT_PER_MIN=10
# QR token requests per user per minute, shared by POST /qr/token and GET /me/qr (portal needs 2).
QR_TOKEN_RATE_LIMIT_PER_MIN=10
# mock | http
TCS_MODE=mock
HRS_MODE=mock
TCS_BASE_URL=http://localhost:4001
HRS_BASE_URL=http://localhost:4002
# FR-2.6: edge sends every 30 s; timeout and monitor period in milliseconds.
EDGE_HEARTBEAT_TIMEOUT_MS=90000
EDGE_HEARTBEAT_CHECK_MS=15000
# Shared secrets for /api/edge/* (#69), comma-separated edgeId:token pairs.
# Empty = all /api/edge/* requests fail closed with 401. Local dev example: EDGE_TOKENS=edge-dev:change-me
EDGE_TOKENS=
# mock | smtp. Mock keeps mail in memory. SMTP_URL: smtp://user:pass@host:587 or smtps://user:pass@host:465
MAIL_MODE=mock
SMTP_URL=
MAIL_FROM=TMC Attendance <no-reply@tmc.local>
# Alert emails, comma-separated (FR-4.6, FR-2.6). EXPORT_FAILED goes to HR and ADM, GATE_OFFLINE to ADM.
# Empty = alerts are only logged.
ALERT_EMAILS_HR=
ALERT_EMAILS_ADM=
# Where employees open the portal; the QR email links to <origin>/portal/qr.
# Origin only: a sub-path (https://host/tmc) is dropped from the link.
PORTAL_URL=http://localhost:5173
# QR signing key, Ed25519 (ADR-10). Only the server holds the private key; edges get public keys from the snapshot.
# Generate a pair:
#   node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log(k.publicKey.export({type:'spki',format:'der'}).toString('base64'))"
# Private key, base64 DER (PKCS8), and its key ID:
QR_SIGNING_KID=
QR_SIGNING_KEY=
# After a rotation: the old key's ID and public key, base64 DER (SPKI), so tokens already issued still verify.
QR_PREVIOUS_KID=
QR_PREVIOUS_PUBLIC_KEY=

# ── Edge agent (ADR-9, apps/edge) ───────────────────────────────────────────
# Unique identifier for this edge instance. One per factory (e.g. edge-binh-duong).
EDGE_ID=edge-dev
# Directory for the SQLite database (edge.db will be created here).
EDGE_DATA_DIR=./data
# Base URL of the central server this edge pushes events to.
SERVER_BASE_URL=http://localhost:3000
# Shared secret matching this EDGE_ID in the server's EDGE_TOKENS (#69). Local dev example: EDGE_TOKEN=change-me
EDGE_TOKEN=
# Edge kiosk API port (default 3100). The shared .env is used by both server and edge,
# so the edge reads EDGE_PORT, not PORT (which the server uses).
EDGE_PORT=3100
# The edge reads TCS_MODE and TCS_BASE_URL from the server section above on purpose:
# both talk to the same TCS. Edge-only TCS timeout:
# TCS_TIMEOUT_MS=1000
# Timing overrides (ms) — usually left at defaults.
# SNAPSHOT_INTERVAL_MS=60000
# OUTBOX_INTERVAL_MS=5000
# HEARTBEAT_INTERVAL_MS=30000
