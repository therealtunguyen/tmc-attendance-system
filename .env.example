DATABASE_URL=postgresql://tmc:tmc@localhost:5432/tmc_attendance
PORT=3000
# Login/MFA attempts per IP per minute.
AUTH_RATE_LIMIT_PER_MIN=10
# mock | http
TCS_MODE=mock
HRS_MODE=mock
TCS_BASE_URL=http://localhost:4001
HRS_BASE_URL=http://localhost:4002
# QR signing key, Ed25519 (ADR-10). Only the server holds the private key; edges get public keys from the snapshot.
# Generate a pair:
#   node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'der'}).toString('base64'));console.log(k.publicKey.export({type:'spki',format:'der'}).toString('base64'))"
# Private key, base64 DER (PKCS8), and its key ID:
QR_SIGNING_KID=
QR_SIGNING_KEY=
# After a rotation: the old key's ID and public key, base64 DER (SPKI), so tokens already issued still verify.
QR_PREVIOUS_KID=
QR_PREVIOUS_PUBLIC_KEY=
