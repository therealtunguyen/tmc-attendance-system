// Each model names its owning module. A module never reads another module's tables, so there are no
// relations across modules: IDs like AttendanceEvent.gateId are plain strings.
// QR signing keys stay in env (QR_SIGNING_*), so they have no table.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Owned by the employee-qr module.
model Employee {
  id        String   @id @default(uuid())
  code      String   @unique
  firstName String
  lastName  String
  // Where the QR page link is sent (FR-1.3).
  email     String
  // Org IDs from the admin module (FR-5.3); plain strings, no relation. RBAC scopes by them (FR-5.2).
  factoryId String
  teamId    String?
  // false = deactivated (FR-1.5). Rows are never deleted: attendance history refers to them.
  active    Boolean  @default(true)
  // HR revoked the QR (FR-1.4); the server stops issuing tokens and edges deny via the snapshot.
  qrRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([factoryId])
  @@index([teamId])
}

enum ScanMethod {
  QR
  MANUAL
}

enum ScanOutcome {
  PENDING
  GRANTED
  DENIED
}

// Owned by the attendance module. eventId makes recording idempotent (FR-3.2).
model AttendanceEvent {
  id         String      @id @default(uuid())
  eventId    String      @unique
  employeeId String?
  gateId     String
  // Edge agent that pushed it (ADR-9). Null for events entered on the server (MANUAL fallback).
  edgeId     String?
  method     ScanMethod
  // FR-2.5: authenticated guard and justification; null for QR and legacy events.
  guardId    String?
  reason     String?
  outcome    ScanOutcome @default(PENDING)
  // Token ID; not unique, so one jti used at two edges is stored and flagged (ADR-10).
  jti        String?
  // Decided from a snapshot older than 5 min; checked against revocations at sync (ADR-9).
  stale      Boolean     @default(false)
  // Edge clock.
  occurredAt DateTime
  // Server clock, to expose a drifting edge clock.
  receivedAt DateTime    @default(now())

  @@index([jti])
  // The security access log filters by gate and time, newest first (FR-4.4).
  @@index([gateId, occurredAt])
  @@index([occurredAt])
}

// Owned by the gate module. One edge agent per factory (ADR-9).
model Edge {
  id              String    @id
  name            String
  // Org ID owned by admin; one edge per factory (ADR-9), no cross-module relation.
  factoryId       String    @unique
  // Heartbeats stop -> offline -> alert ADM (FR-2.6).
  lastHeartbeatAt DateTime?
  // Last successful push; the monthly export checks it (ADR-9, ADR-5).
  lastSyncAt      DateTime?
  gates           Gate[]

  // Composite target for Gate's FK: a gate and its edge must belong to the same factory.
  @@unique([id, factoryId])
}

enum GateDirection {
  IN
  OUT
}

// Owned by the gate module (FR-2.1). Registry rules: docs/gate-registry.md.
// Non-blank string CHECK constraints live in the migration (not expressible in Prisma).
model Gate {
  id          String        @id @default(uuid())
  name        String
  // Org ID owned by admin; repeated here for filtering and enforced against Edge by the FK.
  factoryId   String
  edgeId      String
  location    String
  direction   GateDirection
  // TCS_BASE_URL addresses one TCS namespace; a device has one registry entry, even if inactive.
  turnstileId String        @unique
  // CRUD deletion deactivates the row; attendance history keeps its stable gateId.
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  edge        Edge          @relation(fields: [edgeId, factoryId], references: [id, factoryId], onDelete: Restrict, onUpdate: Restrict)

  @@index([factoryId])
  @@index([edgeId, factoryId])
}

// Owned by the iam module. Append-only and hash-chained (FR-4.9): a trigger rejects UPDATE, DELETE
// and TRUNCATE, and each row's hash covers the previous row's hash, so an edit or a gap is detectable.
model AuditEntry {
  id       String   @id @default(uuid())
  // Chain order. Assigned under an advisory lock, so there is one chain with no forks.
  seq      Int      @unique @default(autoincrement())
  actorId  String
  action   String
  target   String
  // Values before and after a data change (FR-4.9). Null for actions that change nothing.
  before   Json?
  after    Json?
  at       DateTime @default(now())
  prevHash String
  hash     String

  @@index([actorId, at])
  @@index([target, at])
  @@index([at])
}

// Owned by the iam module. A login account (FR-5.1), separate from but linked to an employee record.
model User {
  id           String    @id @default(uuid())
  username     String    @unique
  // scrypt$<salt>$<hash>, see iam.auth.ts. Never the password.
  passwordHash String
  // A Role code; validated in code, not by the database.
  role         String
  // Org unit IDs the user is limited to (FR-5.3). Only meaningful when scoped is true: an empty
  // array with scoped = true means "limited to nothing", which differs from not limited.
  scoped       Boolean   @default(false)
  scopes       String[]  @default([])
  // Plain string, no relation: modules do not relate across tables.
  employeeId   String?   @unique
  // Base32 TOTP secret (FR-5.2). Null until MFA is enrolled.
  mfaSecret    String?
  // Last TOTP step accepted; a code from that step or earlier is a replay.
  mfaLastStep  Int?
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
}

// Owned by the iam module. Opaque bearer session (FR-5.2); mfaPassed is false until the second factor is verified.
model Session {
  id        String    @id @default(uuid())
  // sha256 hex of the opaque token. The raw token is never stored.
  tokenHash String    @unique
  userId    String
  mfaPassed Boolean
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

// Owned by the iam module. A published privacy notice (NFR-20). Versions only grow; a published row is never edited.
model PrivacyNotice {
  version     Int      @id
  text        String
  publishedAt DateTime @default(now())
  publishedBy String
}

// Owned by the iam module. A user's acknowledgement of one notice version (NFR-20).
model NoticeAck {
  userId  String
  version Int
  at      DateTime @default(now())

  @@id([userId, version])
}

// Owned by the admin module. One org tree (FR-5.5): FACTORY > DEPARTMENT > TEAM. The id is a slug chosen
// by the client because Employee.factoryId/teamId and User.scopes already hold such IDs. kind is validated in
// code. Never deleted: employees reference these IDs.
model OrgUnit {
  id            String   @id
  kind          String
  name          String
  parentId      String?
  // IAM user IDs supervising this unit; only used on TEAM (BR-15).
  supervisorIds String[] @default([])
  createdAt     DateTime @default(now())

  @@index([parentId])
}

// Owned by the admin module. System parameters as strings (FR-5.4); the catalogue in admin.config.ts
// validates keys and values and supplies defaults, so a missing row means "use the default".
model ConfigValue {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String
}

enum ExportStatus {
  RUNNING
  BLOCKED
  DONE
  FAILED
}

enum ExportTrigger {
  SCHEDULE
  MANUAL
}

// Owned by the reporting module. The state of one month's HRS export (FR-4.5, FR-4.6); one row per month,
// overwritten by each run. The history of runs, failures and re-runs is in the audit log.
model ExportRun {
  // YYYY-MM
  month      String        @id
  status     ExportStatus
  trigger    ExportTrigger
  attempts   Int           @default(0)
  lastError  String?
  startedAt  DateTime
  finishedAt DateTime?
}
