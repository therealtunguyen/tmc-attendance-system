# Vite development proxy: /api/kiosk/scan -> <edge>/kiosk/scan.
KIOSK_EDGE_URL=http://127.0.0.1:3100
# Browser endpoint; same-origin proxy avoids CORS. Rebuild to change in production.
VITE_KIOSK_SCAN_URL=/api/kiosk/scan
# Production hosting must configure the equivalent reverse proxy; Vite's proxy is dev-only.
